RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_TO_EMAIL=lycheacheurn@gmail.com
RESEND_FROM_EMAIL="Lychea Portfolio <onboarding@resend.dev>"

# Postgres connection string from your Neon project
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin login password and a random secret used to sign session cookies
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

# Vercel Blob read/write token (Storage tab of your Vercel project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
