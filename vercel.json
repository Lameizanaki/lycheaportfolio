    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.lycheaportfolio.site" }],
      "destination": "https://cheurnlychea.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lycheaportfolio.site" }],
      "destination": "https://cheurnlychea.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.cheurnlychea.com" }],
      "destination": "https://cheurnlychea.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.cheurnlychea.com" }],
      "destination": "https://cheurnlychea.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/)(?!@vite)(?!@react-refresh)(?!.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
